// Cloudflare deploy for the playtest build: a Worker that serves the static files in dist/.
// Dashboard deploy command: npm run build && npx wrangler deploy
{
  "name": "lamplight",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
